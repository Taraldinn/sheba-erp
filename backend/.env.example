# ─── Sheba ISP ERP — Backend Environment Variables ───────────────────────────
# Copy this file to .env and fill in values for your deployment.
# NEVER commit .env to version control.

# ─── Django Core ─────────────────────────────────────────────────────────────
# Generate a new secret key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-generate-a-real-secret-key

DEBUG=False

# Comma-separated list of allowed hostnames (no spaces)
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite (development only)
# DATABASE_URL=sqlite:///db.sqlite3
#
# PostgreSQL (production — recommended)
DATABASE_URL=postgres://sheba_user:strongpassword@localhost:5432/sheba_erp

# ─── CORS (Frontend Origins) ─────────────────────────────────────────────────
CORS_ALLOW_ALL_ORIGINS=False
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://app.yourisp.com

# ─── Security ─────────────────────────────────────────────────────────────────
# Set to False if your reverse proxy (nginx) handles SSL termination and redirects
SECURE_SSL_REDIRECT=True

# ─── Redis / Cache (optional — for session persistence across LB instances) ───
# REDIS_URL=redis://localhost:6379/0

# ─── Logging ──────────────────────────────────────────────────────────────────
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
