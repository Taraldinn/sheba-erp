# ─── Sheba ISP ERP — Backend Environment Variables ───────────────────────────
# Copy this file to .env and fill in values for your deployment.
# NEVER commit .env to version control.

# ─── Environment Switch ───────────────────────────────────────────────────────
# Set to 'local' for local development (enables DEBUG, wildcard hosts & CORS, zero SSL redirects)
# Set to 'production' for Dokploy/cloud deployments (strict hosts, HTTPS proxy, no debug)
ENVIRONMENT=local

# ─── Django Core ─────────────────────────────────────────────────────────────
# Generate a new secret key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-generate-a-real-secret-key

# In 'local' mode DEBUG defaults to True; in 'production' mode it defaults to False
DEBUG=True

# Comma-separated list of allowed hostnames (active in production)
ALLOWED_HOSTS=localhost,127.0.0.1,shebafi.xyz,.shebafi.xyz

# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite (development only)
# DATABASE_URL=sqlite:///db.sqlite3
#
# PostgreSQL (production — recommended)
DATABASE_URL=postgres://sheba_user:strongpassword@localhost:5432/sheba_erp

# ─── CORS (Frontend Origins) ─────────────────────────────────────────────────
CORS_ALLOW_ALL_ORIGINS=False
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://app.yourisp.com

# ─── CSRF Trusted Origins (Required for Django behind Reverse Proxy / Dokploy) ─
# Comma-separated list of origins (with scheme) allowed to make POST/PUT requests
CSRF_TRUSTED_ORIGINS=https://app.yourisp.com,https://api.yourisp.com

# ─── Security ─────────────────────────────────────────────────────────────────
# Set to False if your reverse proxy (Dokploy/Traefik) handles SSL termination
SECURE_SSL_REDIRECT=True

# ─── Redis Caching, Distributed Locking & Celery Broker ──────────────────────
# Redis URL format: redis://[:<password>]@<host>:<port>/<db>
# For local development with Docker: redis://redis:6379/0
# For local development on host: redis://localhost:6379/0
# For production Contabo VPS (with password): redis://:your-redis-password@redis:6379/0
# For external/managed Redis: redis://:your-redis-password@your-redis-host:6379/0
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_MAX_MEMORY=256mb

# ─── Performance Caching TTLs (in seconds) ───────────────────────────────────
CACHE_TTL_SUPER_ADMIN_OVERVIEW=120
CACHE_TTL_TENANT_LIST=300
CACHE_TTL_DASHBOARD_ANALYTICS=60

# ─── Logging ──────────────────────────────────────────────────────────────────
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ─── Dokploy & Container Runtime Settings ─────────────────────────────────────
PORT=8000
WEB_CONCURRENCY=3
RUN_MIGRATIONS=true

# ─── Transactional Mailing System (SMTP) ───────────────────────────────────────
# Options: django.core.mail.backends.smtp.EmailBackend, django.core.mail.backends.console.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-smtp-username-or-api-key
EMAIL_HOST_PASSWORD=your-smtp-password-or-secret
DEFAULT_FROM_EMAIL=ShebaFi Platform <noreply@shebafi.xyz>
PASSWORD_RESET_TIMEOUT=900

# ─── Cloudflare R2 / AWS S3 Cloud Storage ──────────────────────────────────────
USE_S3_STORAGE=False
USE_S3_STATIC=False
AWS_ACCESS_KEY_ID=your-r2-or-s3-access-key-id
AWS_SECRET_ACCESS_KEY=your-r2-or-s3-secret-access-key
AWS_STORAGE_BUCKET_NAME=shebafi-storage
# For Cloudflare R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# For AWS S3: leave empty
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=auto
# Optional custom CDN domain for media assets (e.g. cdn.shebafi.xyz)
AWS_S3_CUSTOM_DOMAIN=

