# ==============================================================================
# Sheba ERP Backend — Production Environment Variables
# For Dokploy Docker / Compose VPS Deployment
# ==============================================================================

# ── Core Runtime ─────────────────────────────────────────────────────────────
ENVIRONMENT=production
DEBUG=False
PORT=8000
WEB_CONCURRENCY=3
GUNICORN_TIMEOUT=120
RUN_MIGRATIONS=true
LOG_LEVEL=INFO

# ── Security & Encryption Keys (CRITICAL: Replace with strong secrets!) ─────
# Generate via: python3 -c 'import secrets; print(secrets.token_urlsafe(50))'
SECRET_KEY=change-this-to-a-very-secure-random-50-character-secret-key

# 32-character encryption key for passwords & gateway API secrets in database
# Generate via: python3 -c 'import secrets; print(secrets.token_urlsafe(32)[:32])'
FIELD_ENCRYPTION_KEY=32-char-random-field-encryption-key!

# ── Hostnames & Networking ───────────────────────────────────────────────────
# Whitelist your API domain and VPS IP address (comma-separated)
ALLOWED_HOSTS=api.yourdomain.com,localhost,127.0.0.1

# Canonical SaaS platform owner admin domain
SUPER_ADMIN_DOMAIN=admin.yourdomain.com

# ── CORS & CSRF (Configured for Vercel Frontend) ─────────────────────────────
# Set to your Vercel domains (including apex, admin, app, and wildcard tenant subdomains)
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://admin.yourdomain.com,https://app.yourdomain.com,https://*.vercel.app
CORS_ALLOW_ALL_ORIGINS=False

# CSRF Trusted Origins (must include https:// scheme)
CSRF_TRUSTED_ORIGINS=https://api.yourdomain.com,https://yourdomain.com,https://admin.yourdomain.com,https://app.yourdomain.com

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
# Option A: Built-in Dokploy Compose stack:
DATABASE_URL=postgres://sheba_user:sheba_secure_password@postgres:5432/sheba_erp
POSTGRES_DB=sheba_erp
POSTGRES_USER=sheba_user
POSTGRES_PASSWORD=sheba_secure_password

# Option B: Dokploy Managed PostgreSQL Database:
# DATABASE_URL=postgres://<user>:<password>@<dokploy-postgres-service-name>:5432/<database>

# Option C: External Neon PostgreSQL Serverless Database (Recommended):
# Pooled connection URL (uses Neon PgBouncer for transactional queries):
# DATABASE_URL=postgresql://<user>:<password>@ep-pooler-region.aws.neon.tech/sheba_erp?sslmode=require
# Direct connection URL (for running direct migrations if needed):
# DIRECT_DATABASE_URL=postgresql://<user>:<password>@ep-region.aws.neon.tech/sheba_erp?sslmode=require
# DB_SSLMODE=require
# DB_CONN_MAX_AGE=300

# ── Redis (Cache & Celery Broker) ────────────────────────────────────────────
# Option A: Built-in Dokploy Compose stack:
REDIS_URL=redis://redis:6379/0

# Option B: Dokploy Managed Redis Database:
# REDIS_URL=redis://:<password>@<dokploy-redis-service-name>:6379/0

# ── Celery Worker Settings ───────────────────────────────────────────────────
CELERY_WORKER_CONCURRENCY=4

# ── S3 / Cloudflare R2 Media & Static Storage (Optional) ─────────────────────
USE_S3_STORAGE=False
USE_S3_STATIC=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=auto
