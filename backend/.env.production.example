# ═══════════════════════════════════════════════════════════════════════════════
# ShebaFi ISP ERP — Production Environment (.env.production)
# ═══════════════════════════════════════════════════════════════════════════════
# Usage:
#   1. Generate unique keys:
#      SECRET_KEY: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
#      FIELD_ENCRYPTION_KEY: python -c "import secrets; print(secrets.token_urlsafe(32))"
#   2. Fill in production PostgreSQL and Redis credentials
#   3. Deploy via Docker / Dokploy / VPS
# ═══════════════════════════════════════════════════════════════════════════════

ENVIRONMENT=production
DEBUG=False

# Django Core Security — REQUIRED: Generate unique random keys!
SECRET_KEY=REPLACE_WITH_HIGH_ENTROPY_PRODUCTION_SECRET_KEY
FIELD_ENCRYPTION_KEY=REPLACE_WITH_32_CHAR_BASE64_OR_URLSAFE_ENCRYPTION_KEY

# Allowed Hosts — Strict hostnames (include your base domains and wildcard subdomains)
ALLOWED_HOSTS=api.shebafi.com,admin.shebafi.com,shebafi.com,.shebafi.com,.shebafi.xyz,shebafi.xyz

# Production PostgreSQL Database
# Format: postgres://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgres://sheba_user:STRONG_SECURE_PASSWORD@postgres:5432/sheba_production

# CORS: Strict Origin Enforcement
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://shebafi.com,https://admin.shebafi.com,https://app.shebafi.com,https://shebafi-admin.vercel.app

# CSRF: Trusted HTTPS Origins
CSRF_TRUSTED_ORIGINS=https://shebafi.com,https://admin.shebafi.com,https://*.shebafi.com,https://*.shebafi.xyz,https://*.vercel.app

# SSL Termination & Reverse Proxy (Traefik / Nginx / Cloudflare)
# If your reverse proxy terminates SSL, keep SECURE_PROXY_SSL_HEADER and set SECURE_SSL_REDIRECT=True
SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# Redis & Celery (Distributed Cache, Tenant Resolution, Rate Limiting & Queue)
# Dokploy/Docker example: redis://:REDIS_PASS@redis:6379/0
REDIS_URL=redis://:STRONG_REDIS_PASSWORD@redis:6379/0
CELERY_BROKER_URL=redis://:STRONG_REDIS_PASSWORD@redis:6379/0
CELERY_RESULT_BACKEND=redis://:STRONG_REDIS_PASSWORD@redis:6379/0
CELERY_TASK_ALWAYS_EAGER=False

# Transactional Mailing (SMTP / SendGrid / Postmark / Amazon SES)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=SG.YOUR_SENDGRID_OR_SMTP_KEY
DEFAULT_FROM_EMAIL=ShebaFi Operations <noreply@shebafi.com>
PASSWORD_RESET_TIMEOUT=900

# Cloudflare R2 / AWS S3 Cloud Storage
USE_S3_STORAGE=True
USE_S3_STATIC=False
AWS_ACCESS_KEY_ID=YOUR_R2_OR_S3_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_R2_OR_S3_SECRET_KEY
AWS_STORAGE_BUCKET_NAME=shebafi-media-production
AWS_S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
AWS_S3_REGION_NAME=auto
AWS_S3_CUSTOM_DOMAIN=cdn.shebafi.com

# Container & Dokploy Runtime
PORT=8000
WEB_CONCURRENCY=4
RUN_MIGRATIONS=true
LOG_LEVEL=INFO
