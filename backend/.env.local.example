# ═══════════════════════════════════════════════════════════════════════════════
# ShebaFi ISP ERP — Local Development Environment (.env.local)
# ═══════════════════════════════════════════════════════════════════════════════
# Usage:
#   cp .env.local.example .env
#   python manage.py runserver 0.0.0.0:8000
# ═══════════════════════════════════════════════════════════════════════════════

ENVIRONMENT=local
DEBUG=True

# Django core security
SECRET_KEY=django-insecure-sheba-erp-development-key-change-in-prod-xyz123
FIELD_ENCRYPTION_KEY=dev-local-field-encryption-key-32-chars-long!

# Allowed hosts (in local mode, wildcards and *.localhost are permitted)
ALLOWED_HOSTS=*

# Database: SQLite is default for zero-setup local dev.
# To test with local Postgres instead: postgresql://postgres:postgres@localhost:5432/shebafi_dev
DATABASE_URL=sqlite:///db.sqlite3

# CORS: Permissive in local mode (allows localhost:3000, localhost:3001, etc.)
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# CSRF: Trusted local origins
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# Security & SSL: Disabled for local HTTP development
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Redis & Celery:
# If you don't have Redis installed, leave REDIS_URL empty!
# Celery will automatically run tasks in-process (eager mode) so nothing crashes.
REDIS_URL=
CELERY_TASK_ALWAYS_EAGER=True

# Mailing:
# Empty EMAIL_HOST_USER prints all welcome emails and password reset links
# directly to the console terminal stdout so you can view them instantly!
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=ShebaFi Local <dev@shebafi.local>

# Logging
LOG_LEVEL=INFO
PORT=8000
