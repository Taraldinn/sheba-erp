# ═══════════════════════════════════════════════════════════════════════════════
# Sheba ERP & SaaS — Local Docker Compose Environment (.env.docker.dev)
# ═══════════════════════════════════════════════════════════════════════════════

# Core Django Settings
ENVIRONMENT=local
DEBUG=True
SECRET_KEY=django-insecure-dev-local-secret-key-sheba-erp-1234567890
FIELD_ENCRYPTION_KEY=dev-local-field-encryption-key-32-chars-long!
ALLOWED_HOSTS=*
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# PostgreSQL Database
POSTGRES_DB=sheba_erp_dev
POSTGRES_USER=sheba_dev_user
POSTGRES_PASSWORD=sheba_dev_password
DATABASE_URL=postgres://sheba_dev_user:sheba_dev_password@postgres:5432/sheba_erp_dev

# Redis Cache & Broker
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=

# Celery
CELERY_WORKER_CONCURRENCY=2

# Frontend (sass-frontend-v2)
VITE_API_BASE_URL=http://localhost:8000/api/v1/
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1/
INTERNAL_API_URL=http://backend:8000/api/v1/
INTERNAL_API_BASE_URL=http://backend:8000/api/v1/

# MailHog Local Email Capture
MAILHOG_SMTP_PORT=1025
MAILHOG_WEB_PORT=8025
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mailhog
EMAIL_PORT=1025
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=ShebaFi Platform <noreply@shebafi.xyz>
