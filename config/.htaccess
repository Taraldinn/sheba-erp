RewriteEngine On

# Protect real files and important files from being rewritten
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Specifically protect these files
RewriteRule ^(dashboard\.php|config\.php|visits\.log|index\.php)$ - [L]

# Main rule: send everything else to index.php
RewriteRule ^(.+)$ index.php?path=$1 [L,QSA]