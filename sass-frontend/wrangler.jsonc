{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "shebafi-erp",
    "compatibility_date": "2026-04-01",
    "assets": {
        "directory": "./dist",
        "not_found_handling": "single-page-application"
    },
    "vars": {
        "_comment_": "Production API origin. Replace api.example.com with the real deployment host. Local development uses the Vite dev-server proxy (see vite.config.ts) and ignores this value.",
        "VITE_API_URL": "https://api.example.com/api/v1/",
        "VITE_API_BASE_URL": "https://api.example.com/api/v1/"
    },
    "observability": {
        "enabled": true
    }
}
