# Cloudflare Pages custom-headers file
#
# Reference: https://developers.cloudflare.com/pages/configuration/headers/
#
# Rules are applied top-to-bottom; the first match wins. Do not rely
# on this file for security headers — the backend sets them on the
# API responses. This file is only for static-asset caching.

/assets/*
    Cache-Control: public, max-age=31536000, immutable

/*.js
    Cache-Control: public, max-age=31536000, immutable

/*.css
    Cache-Control: public, max-age=31536000, immutable

/*.woff2
    Cache-Control: public, max-age=31536000, immutable

# HTML entry — never cache, because the SPA shell decides the
# portal type from the Host header at request time.
/*.html
    Cache-Control: no-store, no-cache, must-revalidate
    Pragma: no-cache
    Expires: 0
/
    Cache-Control: no-store, no-cache, must-revalidate
    Pragma: no-cache
    Expires: 0

# Reject crawlers from indexing authenticated routes. The
# PUBLIC_HOME apex is allowed to be indexed; the rest is noindex.
/admin/*
    X-Robots-Tag: noindex, nofollow
/resellers/*
    X-Robots-Tag: noindex, nofollow
/billing/*
    X-Robots-Tag: noindex, nofollow
