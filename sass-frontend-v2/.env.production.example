# ==============================================================================
# Sheba ERP Frontend (Next.js) — Production Environment Variables
# Add these in Vercel Project Settings -> Environment Variables
# ==============================================================================

# ── Backend API Connection ───────────────────────────────────────────────────
# Point to your Dokploy Backend API URL (with /api/v1 suffix)
NEXT_PUBLIC_API_URL=https://shebafi-backend-a3cx0v-936855-194-233-80-190.sslip.io/api/v1/
NEXT_PUBLIC_API_BASE_URL=https://shebafi-backend-a3cx0v-936855-194-233-80-190.sslip.io/api/v1/

# Optional dedicated SaaS control plane base URL (leave blank if same backend)
NEXT_PUBLIC_SAAS_API_BASE_URL=

# ── Hostname & Portal Resolution ─────────────────────────────────────────────
# 1. SaaS Platform Owner Admin Portal (mapped to /saas)
NEXT_PUBLIC_SUPER_ADMIN_HOST=admin.shebafi.xyz

# 2. ISP Owner Admin Dashboard (mapped to /isp)
NEXT_PUBLIC_ISP_HOST=app.shebafi.xyz

# 3. Apex / Public Landing Page (mapped to /)
NEXT_PUBLIC_PUBLIC_HOME_HOST=shebafi.xyz

# 4. Multi-Tenant Root Domain (<tenant>.yourdomain.com routes to /tenant)
NEXT_PUBLIC_TENANT_ROOT_DOMAIN=shebafi.xyz

# 5. Additional custom domains (comma-separated, optional)
NEXT_PUBLIC_KNOWN_APEX_DOMAINS=shebafi.xyz

# ── Feature Flags ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_PUBLIC_SIGNUP_ENABLED=true
NEXT_PUBLIC_SHOW_DEV_PORTAL_SWITCHER=false
