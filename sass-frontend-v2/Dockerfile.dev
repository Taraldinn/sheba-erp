# ==============================================================================
# Development Dockerfile for Sheba Frontend (Next.js 16 + pnpm)
# ==============================================================================
FROM node:22-alpine

WORKDIR /app

# Enable corepack and use pnpm 9 (matches lockfileVersion 9)
RUN corepack enable && corepack prepare pnpm@9.15.5 --activate

# Copy package manifests
COPY package.json pnpm-lock.yaml ./

# Install dependencies
RUN pnpm install --frozen-lockfile

# Expose Next.js dev server port
EXPOSE 3000

ENV PORT=3000 \
    HOSTNAME="0.0.0.0"

CMD ["pnpm", "run", "dev"]
