# =============================================================================
# Shebafi Frontend — environment variables
# Copy this file to .env.local (or your platform's secret store) and replace
# each placeholder. Never commit real secrets, AWS account IDs, or production
# hostnames.
# =============================================================================

# Single configurable API base URL. The frontend prefixes every request with
# this value; the backend CORS / cookie / CSRF policy must be aligned with
# the portal host serving this build.
VITE_API_BASE_URL=https://api.example.com

# Optional second base URL for the SaaS / central plane. If unset, the
# frontend falls back to VITE_API_BASE_URL with the `/api/v1/saas/` prefix
# applied at the per-call level. Set this if your platform uses a dedicated
# SaaS host.
VITE_SAAS_API_BASE_URL=

# ── Hostname / portal resolution ──────────────────────────────────────────
# These values select the portal context (not authorization). The backend
# remains the authority on permissions and tenant membership.

# Hostname that serves the super-admin portal.
VITE_SUPER_ADMIN_HOST=admin.example.com

# Hostname that serves the ISP owner portal.
VITE_ISP_HOST=app.example.com

# Apex / marketing / public landing page hostname.
VITE_PUBLIC_HOME_HOST=example.com

# Tenant root domain. Subdomains under this host resolve to the TENANT
# portal; the part before the dot becomes the tenant slug.
VITE_TENANT_ROOT_DOMAIN=example.com

# ── Feature flags ─────────────────────────────────────────────────────────
# Disable public sign-up if your onboarding is invitation-only.
VITE_PUBLIC_SIGNUP_ENABLED=true

# Show the in-app dev portal switcher. MUST be false in production.
VITE_SHOW_DEV_PORTAL_SWITCHER=false
