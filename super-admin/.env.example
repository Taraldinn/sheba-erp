# ─── ShebaFi Super Admin Control Plane Environment Variables ─────────────────
# Backend API Base URL (including /api/v1 prefix)
# Production API:
NEXT_API_URL=https://api.shebafi.xyz/api/v1

# Local development override (uncomment when running local Django server):
# NEXT_API_URL=http://localhost:8000/api/v1

# Local dev server port (default 3001 to avoid colliding with ISP Admin on 3000)
PORT=3001
