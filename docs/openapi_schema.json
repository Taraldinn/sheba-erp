    Router:
      type: object
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
        expire_pool_script:
          type: string
          readOnly: true
        name:
          type: string
          maxLength: 150
        ip_address:
          type: string
        hostname:
          type: string
          default: ''
          description: Router hostname / FQDN
          maxLength: 255
        api_protocol:
          allOf:
          - $ref: '#/components/schemas/ApiProtocolEnum'
          description: |-
            Protocol used for automated device management

            * `REST` - RouterOS REST API (HTTPS)
            * `API` - RouterOS Binary API (Port 8728)
            * `RADIUS` - RADIUS AAA (Authentication & Accounting)
        https_port:
          type: integer
          maximum: 2147483647
          minimum: 0
          description: RouterOS HTTPS REST API port
        api_port:
          type: integer
          maximum: 2147483647
          minimum: 0
          description: Legacy RouterOS binary API port
        api_ssl:
          type: boolean
        winbox_port:
          type: integer
          maximum: 2147483647
          minimum: 0
        ssl_verify:
          type: boolean
          description: Verify SSL certificate on HTTPS connection
        connection_timeout:
          type: integer
          maximum: 2147483647
          minimum: 0
          description: Connection timeout in seconds
        retry_count:
          type: integer
          maximum: 2147483647
          minimum: 0
          description: Number of retry attempts on network error
        username:
          type: string
          maxLength: 100
        password:
          type: string
          writeOnly: true
          maxLength: 500
        radius_secret:
          type: string
          writeOnly: true
          description: RADIUS Shared Secret
          maxLength: 255
        radius_auth_port:
          type: integer
          maximum: 2147483647
          minimum: 0
          description: RADIUS Authentication UDP Port
        radius_acct_port:
          type: integer
          maximum: 2147483647
          minimum: 0
          description: RADIUS Accounting UDP Port
        radius_coa_port:
          type: integer
          maximum: 2147483647
          minimum: 0
          description: RADIUS CoA / Disconnect-Request (PoD) UDP Port
        nas_identifier:
          type: string
          description: NAS-Identifier
          maxLength: 100
        expire_pool_enabled:
          type: boolean
          description: Route expired prepaid users to low-speed captive pool instead
            of hard disconnect
        expire_pool_name:
          type: string
          maxLength: 64
        expire_profile_name:
          type: string
          maxLength: 64
        expire_rate_limit:
          type: string
          description: Throttled bandwidth rate limit for expired users (10k-50k allowed,
            e.g. 10k/50k)
          maxLength: 30
        expire_pool_network:
          type: string
          description: IP range leased to expired subscribers
          maxLength: 100
        expire_local_address:
          type: string
          description: Default gateway IP for expired pool
        expire_redirect_url:
          type: string
          description: Payment portal URL for captive popup redirection
          maxLength: 255
        expire_walled_garden:
          type: string
          description: Comma-separated payment domains allowed in captive mode
        location:
          type: string
          maxLength: 255
        description:
          type: string
        latitude:
          type: string
          format: decimal
          pattern: ^-?\d{0,3}(?:\.\d{0,7})?$
          nullable: true
        longitude:
          type: string
          format: decimal
          pattern: ^-?\d{0,3}(?:\.\d{0,7})?$
          nullable: true
        status:
          $ref: '#/components/schemas/RouterStatusEnum'
        routeros_version:
          type: string
          description: RouterOS Version (e.g. 7.14.3)
          maxLength: 50
        cpu_usage:
          type: integer
          readOnly: true
          description: CPU load %
        memory_usage:
          type: integer
          readOnly: true
          description: Memory load %
        disk_usage:
          type: integer
          readOnly: true
          description: Disk usage %
        uptime:
          type: string
          readOnly: true
        active_pppoe_count:
          type: integer
          maximum: 2147483647
          minimum: 0
        total_customers_count:
          type: integer
          maximum: 2147483647
          minimum: 0
        last_ping:
          type: string
          format: date-time
          readOnly: true
          nullable: true
        is_active:
          type: boolean
        created_at:
          type: string
          format: date-time
          readOnly: true
        updated_at:
          type: string
          format: date-time
          readOnly: true
        tenant:
          type: string
          format: uuid
          readOnly: true
      required:
      - cpu_usage
      - created_at
      - disk_usage
      - expire_pool_script
      - id
      - ip_address
      - last_ping
      - memory_usage
      - name
      - tenant
      - updated_at
      - uptime
