components:
  schemas:
    AccentColorEnum:
      enum:
      - indigo
      - emerald
      - violet
      - cyan
      - amber
      - rose
      type: string
      description: |-
        * `indigo` - Electric Indigo
        * `emerald` - Cyber Emerald
        * `violet` - Ultra Violet
        * `cyan` - Neon Cyan
        * `amber` - Golden Amber
        * `rose` - Vibrant Rose
    AccessModeEnum:
      enum:
      - EPON
      - GPON
      type: string
      description: |-
        * `EPON` - EPON
        * `GPON` - GPON
    Adjustment:
      type: object
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
        customer:
          type: string
          format: uuid
          readOnly: true
        customer_id:
          type: string
          format: uuid
          writeOnly: true
        customer_name:
          type: string
          readOnly: true
        pppoe_username:
          type: string
          readOnly: true
        adjustment_type:
          $ref: '#/components/schemas/AdjustmentTypeEnum'
        amount:
          type: string
          format: decimal
          pattern: ^-?\d{0,10}(?:\.\d{0,2})?$
        reason:
          type: string
        approved_by:
          type: string
          readOnly: true
        ledger_entry:
          type: string
          format: uuid
          readOnly: true
          nullable: true
        created_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - adjustment_type
      - amount
      - approved_by
      - created_at
      - customer
      - customer_id
      - customer_name
      - id
      - ledger_entry
      - pppoe_username
      - reason
    AdjustmentTypeEnum:
      enum:
      - CREDIT
      - DEBIT
      - WAIVER
      - PENALTY
      type: string
      description: |-
        * `CREDIT` - Credit (add to balance)
        * `DEBIT` - Debit (deduct from balance)
        * `WAIVER` - Fee waiver
        * `PENALTY` - Late payment penalty
    AdvanceSalary:
      type: object
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
        employee_name:
          type: string
          readOnly: true
        amount:
          type: string
          format: decimal
          pattern: ^-?\d{0,8}(?:\.\d{0,2})?$
        request_date:
          type: string
          format: date
        deduction_month:
          type: string
          maxLength: 20
        reason:
          type: string
        status:
          $ref: '#/components/schemas/AdvanceSalaryStatusEnum'
        created_at:
          type: string
          format: date-time
          readOnly: true
        tenant:
          type: string
          format: uuid
          readOnly: true
        employee:
          type: string
          format: uuid
      required:
      - amount
      - created_at
      - employee
      - employee_name
      - id
      - tenant
    AdvanceSalaryStatusEnum:
      enum:
      - Pending
      - Approved
      - Disbursed
      - Recovered
      type: string
      description: |-
        * `Pending` - Pending
        * `Approved` - Approved
        * `Disbursed` - Disbursed
        * `Recovered` - Recovered
    AgentPBXMapping:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        agent_name:
          type: string
          readOnly: true
        extension:
          type: string
          description: PBX extension (e.g. 101)
          maxLength: 20
        tenant:
          type: string
          format: uuid
          readOnly: true
        agent:
          type: integer
      required:
      - agent
      - agent_name
      - extension
      - id
      - tenant
    AggregationPolicyEnum:
      enum:
      - AGGREGATE_SUM
      - PER_CIRCUIT
      type: string
      description: |-
        * `AGGREGATE_SUM` - Aggregate Circuit Sum
        * `PER_CIRCUIT` - Per-Circuit Individual
    ApiProtocolEnum:
      enum:
      - REST
      - API
      - RADIUS
      type: string
      description: |-
        * `REST` - RouterOS REST API (HTTPS)
        * `API` - RouterOS Binary API (Port 8728)
        * `RADIUS` - RADIUS AAA (Authentication & Accounting)
    ApplyCoupon:
      type: object
      description: Used by /discount-coupons/apply/ — validates then returns the discount.
      properties:
        code:
          type: string
          maxLength: 50
        invoice_id:
          type: string
          format: uuid
        invoice_total:
          type: string
          format: decimal
          pattern: ^-?\d{0,10}(?:\.\d{0,2})?$
      required:
      - code
    AreaBreakdown:
      type: object
