openapi: 3.0.3
info:
  title: ShebaFi ISP ERP & SaaS Control Plane API
  version: 2.0.0
  description: Production-grade, Multi-Tenant ISP Operations, MikroTik/OLT Automation,
    Double-Entry Financial Ledgers, Hierarchical Network Topology & Impact Analysis,
    Customer Self-Care Portal, and SaaS Global Control Plane.
paths:
  /:
    get:
      operationId: root_retrieve
      description: Root landing endpoint providing system metadata and quick links.
      tags:
      - 14. Core & Tenant Settings
      security:
      - apiKeyHeaderAuth: []
      - apiKeyAuthorizationAuth: []
      - tokenAuth: []
      - cookieAuth: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                type: object
                additionalProperties: {}
          description: ''
  /ajax/checkout_status.php:
    get:
      operationId: ajax_checkout_status.php_retrieve
      description: |-
        Polling endpoint with MFS catch-up matching by username reference first, then payer mobile.
        GET /api/v1/payments/checkout-status/ (Read-only polling)
        POST /api/v1/payments/checkout-status/ (Authorized settlement)
      tags:
      - ajax
      security:
      - apiKeyHeaderAuth: []
      - apiKeyAuthorizationAuth: []
      - tokenAuth: []
      - cookieAuth: []
      responses:
        '200':
          description: No response body
    post:
      operationId: ajax_checkout_status.php_create
      description: |-
        Polling endpoint with MFS catch-up matching by username reference first, then payer mobile.
        GET /api/v1/payments/checkout-status/ (Read-only polling)
        POST /api/v1/payments/checkout-status/ (Authorized settlement)
      tags:
      - ajax
      security:
      - apiKeyHeaderAuth: []
      - apiKeyAuthorizationAuth: []
      - tokenAuth: []
      - cookieAuth: []
      responses:
        '200':
          description: No response body
  /api/payBill:
    post:
      operationId: api_payBill_create
      description: |-
        Official bKash PayBill Biller Payment Settlement API (v1.4 Section 1.2).
        bKash Middleware calls this when a customer pays their ISP bill through bKash.
        POST /api/payBill/ or /api/v1/payments/bkash/paybill/pay/
      tags:
      - api
      security:
      - apiKeyHeaderAuth: []
      - apiKeyAuthorizationAuth: []
      - tokenAuth: []
      - cookieAuth: []
      - {}
      responses:
        '200':
          description: No response body
  /api/payBill/:
    post:
